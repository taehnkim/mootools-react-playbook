{
  "schemaVersion": 1,
  "id": "tab-pane",
  "displayName": "TabPane",
  "legacyGlobal": "TabPane",
  "sourceFiles": [
    "legacy/components/tab-pane/TabPane.js",
    "legacy/components/tab-pane/TabPane.Extra.js"
  ],
  "cssFiles": [
    "legacy/styles.css",
    "src/global.css"
  ],
  "markupFiles": [
    {
      "path": "legacy/index.html",
      "rootSelector": "#tab-pane"
    }
  ],
  "bootstrapFiles": [
    "legacy/bootstrap.ts"
  ],
  "scanRoots": [
    "legacy",
    "src"
  ],
  "callsiteGlobs": [
    "legacy/main.js",
    "src/**/*.{js,jsx,ts,tsx}"
  ],
  "fixtureBridge": {
    "windowValueKey": "__MOOTOOLS_MIGRATION_FIXTURE__",
    "windowIdKey": "__MOOTOOLS_MIGRATION_FIXTURE_ID__",
    "legacyStaticFixtureId": "default-tabs",
    "reactAcknowledgementPath": [
      "ReactSandbox",
      "fixtureId"
    ]
  },
  "legacy": {
    "entryPath": "/legacy/",
    "readyPath": [
      "MooSandbox",
      "tabPane"
    ],
    "eventNames": [
      "add",
      "close",
      "change"
    ]
  },
  "react": {
    "entryPath": "/",
    "readySelector": "[data-migration-component=\"tab-pane\"]",
    "handlePath": [
      "ReactSandbox",
      "tabPane"
    ],
    "componentPath": "src/components/tab-pane/TabPane.tsx"
  },
  "adapter": {
    "globalName": "mountTabPane",
    "outputPath": "legacy/adapters/mount-tab-pane.js",
    "callsiteFiles": [
      "legacy/main.js"
    ],
    "bootstrapFile": "legacy/bootstrap.ts",
    "bootstrapImportAnchor": "import mainUrl from \"./main.js?url\";",
    "bootstrapArrayAnchor": "mainUrl,",
    "bootstrapImportPath": "./adapters/mount-tab-pane.js"
  }
}
