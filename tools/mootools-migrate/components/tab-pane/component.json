{
  "schemaVersion": 1,
  "id": "tab-pane",
  "displayName": "TabPane",
  "legacyGlobal": "TabPane",
  "sourceFiles": [
    "components/tab-pane/TabPane.js",
    "components/tab-pane/TabPane.Extra.js"
  ],
  "cssFiles": [
    "styles.css",
    "src/global.css"
  ],
  "markupFiles": [
    {
      "path": "index.html",
      "rootSelector": "#tab-pane"
    }
  ],
  "bootstrapFiles": [
    "bootstrap.ts"
  ],
  "scanRoots": [
    ".",
    "src"
  ],
  "callsiteGlobs": [
    "main.js",
    "src/**/*.{js,jsx,ts,tsx}"
  ],
  "tests": {
    "legacyFile": "components/tab-pane/TabPane.legacy.test.ts",
    "legacyDependencies": [
      "vendor/mootools-core-1.4.2.js"
    ],
    "reactFile": "src/components/tab-pane/TabPane.test.tsx",
    "reactDependencies": []
  },
  "fixtureBridge": {
    "windowValueKey": "__MOOTOOLS_MIGRATION_FIXTURE__",
    "windowIdKey": "__MOOTOOLS_MIGRATION_FIXTURE_ID__",
    "legacyStaticFixtureId": "default-tabs",
    "reactAcknowledgementPath": [
      "ReactSandbox",
      "fixtureId"
    ]
  },
  "legacy": {
    "entryPath": "/",
    "readyPath": [
      "MooSandbox",
      "tabPane"
    ],
    "eventNames": [
      "add",
      "close",
      "change"
    ]
  },
  "react": {
    "entryPath": "/react.html",
    "readySelector": "[data-migration-component=\"tab-pane\"]",
    "handlePath": [
      "ReactSandbox",
      "tabPane"
    ],
    "componentPath": "src/components/tab-pane/TabPane.tsx"
  },
  "adapter": {
    "globalName": "mountTabPane",
    "outputPath": "adapters/mount-tab-pane.js",
    "callsiteFiles": [
      "main.js"
    ],
    "bootstrapFile": "bootstrap.ts",
    "bootstrapImportAnchor": "import mainUrl from \"./main.js?url\";",
    "bootstrapArrayAnchor": "mainUrl,",
    "bootstrapImportPath": "./adapters/mount-tab-pane.js"
  }
}
