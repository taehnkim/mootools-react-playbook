          "afterStepId": "submit-new-tab",
          "target": "status",
          "kind": "text",
          "matcher": "equals",
          "expected": "Showing tab 4."
        },
        {
          "assertionId": "title-focus-restored",
          "afterStepId": "submit-new-tab",
          "target": "new-tab-title",
          "kind": "focus",
          "matcher": "equals",
          "expected": true
        },
        {
          "assertionId": "add-event-order",
          "afterStepId": "submit-new-tab",
          "target": "$events",
          "kind": "event-trace",
          "matcher": "equals",
          "expected": [
            {
              "name": "add",
              "args": [
                3
              ]
            },
            {
              "name": "change",
              "args": [
                3
              ]
            }
          ]
        },
        {
          "assertionId": "added-component-image",
          "afterStepId": "submit-new-tab",
          "target": "component",
          "kind": "screenshot",
          "matcher": "pixel-diff",
          "name": "component",
          "maxDiffRatio": 0
        }
      ]
    },
