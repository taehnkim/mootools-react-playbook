  "scenarios": [
    {
      "id": "initial-selection",
      "fixture": "default-tabs",
      "steps": [
        {
          "stepId": "observe-initial",
          "action": "observe"
        }
      ],
      "assertions": [
        {
          "assertionId": "initial-tab-count",
          "afterStepId": "observe-initial",
          "target": "tabs",
          "kind": "count",
          "matcher": "equals",
          "expected": 3
        },
        {
          "assertionId": "hello-is-active",
          "afterStepId": "observe-initial",
          "target": "tab:hello",
          "kind": "class",
          "matcher": "present",
          "className": "active",
          "expected": true
        },
        {
          "assertionId": "hello-panel-visible",
          "afterStepId": "observe-initial",
          "target": "panel:hello",
          "kind": "visible",
          "matcher": "equals",
          "expected": true
        },
        {
          "assertionId": "behavior-panel-hidden",
          "afterStepId": "observe-initial",
          "target": "panel:behavior",
          "kind": "visible",
          "matcher": "equals",
          "expected": false
        },
        {
          "assertionId": "hello-close-label",
          "afterStepId": "observe-initial",
          "target": "tab:hello:close",
          "kind": "attribute",
          "matcher": "equals",
          "attribute": "aria-label",
          "expected": "Close Hello tab"
        },
        {
          "assertionId": "hello-panel-display",
          "afterStepId": "observe-initial",
          "target": "panel:hello",
          "kind": "computed-style",
          "matcher": "equals",
          "property": "display",
          "expected": "block"
        },
        {
          "assertionId": "initial-status",
          "afterStepId": "observe-initial",
          "target": "status",
          "kind": "text",
          "matcher": "equals",
          "expected": "Showing tab 1."
        },
        {
          "assertionId": "initial-component-image",
          "afterStepId": "observe-initial",
          "target": "component",
          "kind": "screenshot",
          "matcher": "pixel-diff",
          "name": "component",
          "maxDiffRatio": 0
        }
      ]
    },
    {
      "id": "select-second-tab",
      "fixture": "default-tabs",
      "steps": [
        {
          "stepId": "click-behavior",
          "action": "click",
          "target": "tab:behavior"
        }
      ],
      "assertions": [
        {
          "assertionId": "behavior-is-active",
          "afterStepId": "click-behavior",
          "target": "tab:behavior",
          "kind": "class",
          "matcher": "present",
          "className": "active",
          "expected": true
        },
        {
          "assertionId": "behavior-panel-visible",
          "afterStepId": "click-behavior",
          "target": "panel:behavior",
          "kind": "visible",
          "matcher": "equals",
          "expected": true
        },
        {
          "assertionId": "second-tab-status",
          "afterStepId": "click-behavior",
          "target": "status",
          "kind": "text",
          "matcher": "equals",
          "expected": "Showing tab 2."
        },
        {
          "assertionId": "select-event-order",
          "afterStepId": "click-behavior",
          "target": "$events",
          "kind": "event-trace",
          "matcher": "equals",
          "expected": [
            {
              "name": "change",
              "args": [
                1
              ]
            }
          ]
        },
        {
          "assertionId": "second-tab-component-image",
