  "fixtures": {
    "default-tabs": {
      "selectedId": "hello",
      "tabs": [
        {
          "id": "hello",
          "label": "Hello",
          "contentHeading": "Hello world",
          "closable": true
        },
        {
          "id": "behavior",
          "label": "Behavior",
          "contentHeading": "Delegated events",
          "closable": true
        },
        {
          "id": "migration-notes",
          "label": "Migration notes",
          "contentHeading": "A useful first migration",
          "closable": true
        }
      ]
    }
