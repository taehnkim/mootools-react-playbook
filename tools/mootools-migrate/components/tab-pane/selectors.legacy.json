{
  "schemaVersion": 1,
  "componentId": "tab-pane",
  "surface": "legacy",
  "selectors": {
    "component": "#tab-pane",
    "tabs": "#tab-pane .tab",
    "tab:hello": "#tab-pane .tab:has-text(\"Hello\")",
    "tab:behavior": "#tab-pane .tab:has-text(\"Behavior\")",
    "tab:migration-notes": "#tab-pane .tab:has-text(\"Migration notes\")",
    "tab:agent": "#tab-pane .tab:has-text(\"Agent tab\")",
    "tab:last": "#tab-pane .tab:last-child",
    "tab:hello:close": "#tab-pane [aria-label=\"Close Hello tab\"]",
    "tab:behavior:close": "#tab-pane [aria-label=\"Close Behavior tab\"]",
    "tab:migration-notes:close": "#tab-pane [aria-label=\"Close Migration notes tab\"]",
    "panel:hello": "#tab-pane .content:has-text(\"Hello world\")",
    "panel:behavior": "#tab-pane .content:has-text(\"Delegated events\")",
    "panel:migration-notes": "#tab-pane .content:has-text(\"A useful first migration\")",
    "panel:agent": "#tab-pane .content:has-text(\"Created by the migration harness.\")",
    "panel:last": "#tab-pane .content:last-of-type",
    "new-tab-title": "#new-tab-title",
    "new-tab-content": "#new-tab-content",
    "add-tab": "#add-tab-form button[type=\"submit\"]",
    "status": "#tab-pane-status"
  }
}
